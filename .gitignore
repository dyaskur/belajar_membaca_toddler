node_modules
/build
/.svelte-kit
/package
.env
.env.*
!.env.example
.DS_Store
.idea
# Generated audio IS committed so the app runs offline without a TTS key.
# Regenerate/refresh with `npm run generate:audio`.

# Scratch TTS pronunciation candidates for the /preview page (generated, not committed).
static/preview/

# Playwright smoke-test output (see .github/workflows/preview.yml).
/shots
/test-results
/playwright-report
/playwright-results.json

# Android release signing key — must never be committed. The CI release job restores it
# from the ANDROID_KEYSTORE_BASE64 secret instead (see .github/workflows/android.yml).
*.keystore
*.jks

# Album Kata source downloads and background-removal cutouts are reproducible
# working files. Only the optimized static/kata WebPs are committed.
/assets/kata-src/*.jpg
/assets/kata-src/*.jpeg
/assets/kata-src/*.png
/assets/kata-cut/
